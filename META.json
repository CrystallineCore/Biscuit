{
  "name": "biscuit",
  "abstract": "A bitmap-based index for wildcard pattern matching",
  "description": "Biscuit is a bitmap-based index access method that accelerates LIKE and ILIKE pattern matching in PostgreSQL, plus regular expressions that reduce exactly to a LIKE pattern. It is strongest on anchored patterns, '_' wildcards and length predicates, and supports multi-column indexes.",
